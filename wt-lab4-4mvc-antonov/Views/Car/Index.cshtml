@model List<wt_lab4_4mvc_antonov.Models.Car>

@{
    ViewData["Title"] = "Автомобили";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold">🚗 Прокат автомобилей</h1>
            <p class="text-muted">Каталог доступных машин</p>
        </div>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> Добавить автомобиль
        </a>
    </div>

    @* Форма фильтра по марке (дополнительная операция) *@
    <form asp-action="Filter" method="get" class="row g-2 mb-4">
        <div class="col-md-4">
            <input type="text" name="brand" class="form-control"
                   placeholder="Фильтр по марке (Toyota, BMW…)"
                   value="@ViewBag.FilterBrand" />
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-outline-primary">
                <i class="bi bi-search"></i> Найти
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary">Сбросить</a>
        </div>
    </form>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">Автомобили не найдены.</div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var car in Model)
            {
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm rounded-4">
                        <div class="card-body d-flex flex-column">
                            <span class="badge bg-secondary mb-2 align-self-start">
                                ID: @car.Id
                            </span>
                            <h5 class="card-title">@car.Brand @car.Model</h5>
                            <p class="text-muted mb-2">Год выпуска: @car.Year</p>
                            <p class="fs-4 fw-bold mb-2">@car.PricePerDay ₽ / сутки</p>

                            @if (car.IsAvailable)
                            {
                                <span class="badge bg-success mb-3">Доступен</span>
                            }
                            else
                            {
                                <span class="badge bg-danger mb-3">Занят</span>
                            }

                            <div class="mt-auto d-flex gap-2">
                                <a asp-action="Details" asp-route-id="@car.Id"
                                   class="btn btn-outline-primary btn-sm">
                                    Подробнее
                                </a>
                                <a asp-action="Edit" asp-route-id="@car.Id"
                                   class="btn btn-outline-warning btn-sm">
                                    Изменить
                                </a>
                                <form asp-action="Delete" asp-route-id="@car.Id"
                                      method="post" class="d-inline"
                                      onsubmit="return confirm('Удалить автомобиль?');">
                                    <button type="submit" class="btn btn-outline-danger btn-sm">
                                        Удалить
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>